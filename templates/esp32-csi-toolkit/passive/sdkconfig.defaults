ESP32_WIFI_CSI_ENABLED=true
ESP32_WIFI_NVS_ENABLED=true

ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
ESP32_WIFI_DYNAMIC_TX_BUFFER=true
ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32
ESP32_WIFI_STATIC_RX_BUFFER_NUM=10
ESP32_WIFI_IRAM_OPT=true
ESP32_WIFI_RX_IRAM_OPT=true

ESPTOOLPY_FLASHSIZE_4MB=true

SHOULD_COLLECT_CSI=true
SHOULD_COLLECT_ONLY_LLTF=true
SEND_CSI_TO_SERIAL=false
SEND_CSI_TO_SD=false

# Associate purely to carry the UDP uplink. The node still transmits no
# sensing traffic of its own; see PASSIVE_UPLINK in Kconfig.projbuild.
PASSIVE_UPLINK=true
ESP_WIFI_SSID="espeon"
ESP_WIFI_PASSWORD="espeon123!"
CHANNEL_SURVEY=true

SEND_CSI_TO_UDP=true
UDP_TARGET_IP="192.168.4.1"
UDP_TARGET_PORT=5566

# Must match the AP while PASSIVE_UPLINK is on.
WIFI_CHANNEL=11
